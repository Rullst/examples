# ==============================================================================
# Rullst Framework - Environment Configuration Template
# Copy this file to .env and customize values for your deployment
# NEVER commit your actual .env file with production secrets!
# ==============================================================================

# Application Server
PORT=3000
APP_ENV=production
RUST_LOG=info,rullst=info

# Database (SQLite default)
DATABASE_URL=sqlite://blog.db

# Domain & SSL (Used by Caddy)
# Set your Azure VM domain or IP here (e.g. blog.yourdomain.com or 20.xxx.xxx.xxx)
DOMAIN=localhost

# Security & Sessions
# APP_KEY=generate_with_cargo_rullst_key_generate
# SESSION_SECRET=change_me_in_production_32_bytes_min

# AI Provider (Optional - Gemini / OpenAI / Claude)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Mailer (Optional - Resend / SendGrid / Postmark / SMTP)
# RESEND_API_KEY=your_resend_api_key_here
# MAILER_FROM=noreply@yourdomain.com

# Capital / Payments (Optional - Stripe / MercadoPago / Asaas)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
