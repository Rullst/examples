{
  "rules": [
    {
      "enabled": true,
      "name": "delete-old-database-backups",
      "type": "Lifecycle",
      "definition": {
        "actions": {
          "baseBlob": {
            "delete": {
              "daysAfterModificationGreaterThan": 90
            }
          }
        },
        "filters": {
          "blobTypes": [
            "blockBlob"
          ],
          "prefixMatch": [
            "database-backups/"
          ]
        }
      }
    }
  ]
}
