APP_KEY=REPLACE_WITH_A_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
RULLST_ENV=development

# Persistent PostgreSQL
# Local example:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rullst_saas
# Azure staging: store an Azure Database for PostgreSQL or Neon connection
# string as a Container Apps secret and map it to DATABASE_URL. Require TLS.

# Private Nexus admin (required; password must be at least 16 characters)
NEXUS_ADMIN_USERNAME=
NEXUS_ADMIN_PASSWORD=

# Billing mode: disabled or test. Live remains fail-closed until the sandbox,
# refund and production acceptance gates documented in README.md are complete.
PAYMENTS_MODE=disabled

# Stripe is the first one-time checkout rollout. Other exported adapters remain
# capability-report entries until each receives its own audited contract.
BILLING_PROVIDER=stripe
BILLING_PRICE_ID=
BILLING_EXPECTED_CURRENCY=BRL
BILLING_EXPECTED_AMOUNT_MINOR=100
BILLING_REDIRECT_URL=http://localhost:3000/dashboard

# Stripe sandbox only: never paste these values into source control or chat.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
