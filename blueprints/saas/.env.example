APP_KEY=REPLACE_WITH_A_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
RULLST_ENV=development

# Persistent PostgreSQL
# Local example:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rullst_saas
# Azure staging: store an Azure Database for PostgreSQL or Neon connection
# string as a Container Apps secret and map it to DATABASE_URL. Require TLS.

# Private Nexus admin (required; password must be at least 16 characters)
NEXUS_ADMIN_USERNAME=
NEXUS_ADMIN_PASSWORD=

# Password recovery is fail-closed until a transactional provider is configured.
# Verify the sending domain with Resend, create a sending-only/domain-scoped API
# key, and use the exact public origin for this deployment. Never share a key
# between staging and production.
PASSWORD_RESET_MODE=disabled
ACCOUNT_PUBLIC_BASE_URL=http://localhost:3000
ACCOUNT_MAIL_FROM=
RESEND_API_KEY=

# Billing mode: disabled, test or live. Keep disabled until the matching
# environment-specific acceptance gate documented in README.md is complete.
PAYMENTS_MODE=disabled

# Stripe is the first one-time checkout rollout. Other exported adapters remain
# capability-report entries until each receives its own audited contract.
BILLING_PROVIDER=stripe
BILLING_PRICE_ID=
BILLING_EXPECTED_CURRENCY=BRL
BILLING_EXPECTED_AMOUNT_MINOR=100
BILLING_REDIRECT_URL=http://localhost:3000/dashboard

# Stripe test or live credentials must match PAYMENTS_MODE. Never paste these
# values into source control or chat.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Live-only fail-closed controls. Generate RECONCILIATION_TOKEN with at least
# 32 random characters. PAID_ARTIFACT_URL is a query-free private Azure Blob
# URL read through the Container App's managed identity;
# PAID_ARTIFACT_SHA256 pins the exact private Markdown bytes.
LIVE_PAYMENTS_ACKNOWLEDGEMENT=
RECONCILIATION_TOKEN=
PAID_ARTIFACT_URL=
PAID_ARTIFACT_STORAGE_ACCOUNT=
PAID_ARTIFACT_SHA256=
PAID_ARTIFACT_FILENAME=rullst-stripe-production-guide-v1.md

# Public merchant and refund notice fields required by live mode. Store their
# values only in the deployment secret manager, never in this file or Git.
# Brazilian consumer rules require the tax ID and physical address to be shown
# publicly before purchase; use a legally valid public correspondence address.
MERCHANT_LEGAL_NAME=
MERCHANT_TAX_ID=
MERCHANT_PHYSICAL_ADDRESS=
MERCHANT_COUNTRY=BR
SUPPORT_EMAIL=officialrullst@gmail.com
REFUND_WINDOW_DAYS=14
