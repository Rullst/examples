APP_KEY=REPLACE_WITH_YOUR_32_CHAR_RANDOM_KEY
RULLST_ENV=development

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite://db.sqlite?mode=rwc

# Public shared demo; set false for private LMS deployments.
LMS_SHOWCASE_MODE=true
# Comma-separated platform account emails authorized to use admin tools.
LMS_ADMIN_EMAILS=
